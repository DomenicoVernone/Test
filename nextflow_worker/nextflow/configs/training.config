// training.config — default parameters for training.nf
// Override these via CLI: nextflow run training.nf --experiment_name hc_vs_bvFTD ...

params {
    // ── Identità dell'esperimento ──────────────────────────────────────────────
    brain_segmenter    = "fastsurfer"           // "freesurfer" o "fastsurfer"
    experiment_name    = "hc_vs_bvFTD"          // nome della comparazione
    selection_method   = "lasso"                // "lasso" o "rfe"
    sperimental        = "bvFTD"                // label del gruppo patologico
    control            = "HC"                   // label del gruppo controllo
    parallel_training  = true                   // true → parallel, false → sequential

    // ── Percorsi script R ─────────────────────────────────────────────────────
    merge_script      = "${projectDir}/../ftd_diagnosis/util/merge_radiomics.r"
    rfe_script        = "${projectDir}/../ftd_diagnosis/sequential/RFE.r"
    lasso_script      = "${projectDir}/../ftd_diagnosis/sequential/lasso.r"
    selection         = "${projectDir}/../ftd_diagnosis/parallel/features_selection.r"
    metrics_script    = "${projectDir}/../ftd_diagnosis/util/process_metrics.r"
    stability_script  = "${projectDir}/../ftd_diagnosis/util/stability.r"

    // ── Modelli paralleli ──────────────────────────────────────────────────────
    svm = "${projectDir}/../ftd_diagnosis/parallel/models/svm.r"
    rf  = "${projectDir}/../ftd_diagnosis/parallel/models/random_forest.r"
    knn = "${projectDir}/../ftd_diagnosis/parallel/models/kNN.r"
    xgb = "${projectDir}/../ftd_diagnosis/parallel/models/XGBoost.r"

    // ── Dati input ────────────────────────────────────────────────────────────
    feat_output       = "/shared_data/nf_output/features"
    labels            = "/app/data/external/ROI_labels.tsv"
    demographic_data  = null                    // path CSV demografici (opzionale)

    // ── Configurazione ─────────────────────────────────────────────────────────
    config            = "${projectDir}/configs/hyperparameters.yaml"
    env               = "${projectDir}/../.env.example"
}

process {
    withName: 'aggregate_features|sequential_training|select_features|parallel_training|frequency_stability|aggregate_metrics' {
        container = 'ftd-training'
    }
}

docker {
    enabled = true
}
