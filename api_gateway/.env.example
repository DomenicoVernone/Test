# .env.example — api_gateway
# Copia questo file in .env e compila i valori prima di avviare il servizio.

SECRET_KEY=cambia-questa-chiave-con-una-robusta-in-produzione
DATABASE_URL=sqlite:////shared_db/clinical_twin.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:8001","http://localhost:8002","http://localhost:8003"]

# Gmail SMTP — usa una App Password (non la password account)
# https://myaccount.google.com → Sicurezza → Password per le app
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your_gmail@gmail.com
MAIL_FROM_NAME=MLOps Clinical